# Keep the exact deployed application JAR; do not rebuild business classes here.
FROM swr.cn-north-4.myhuaweicloud.com/javaee_xmu/rbac-backend@sha256:a49579eed569d64cfaeba953769eb00d9fe56586d65f378a54daa4900a38c9ba AS application
FROM swr.cn-north-4.myhuaweicloud.com/oomall-javaee/openjdk@sha256:cab51c50750848d1f3da11f57d9994be445db7bf06d2916408fac65ad389469b AS tooling
WORKDIR /tools
RUN set -eu; for artifact in org.jacoco.agent/0.8.14/org.jacoco.agent-0.8.14-runtime org.jacoco.cli/0.8.14/org.jacoco.cli-0.8.14-nodeps; do \
      name=${artifact##*/}; \
      wget -q "https://repo.huaweicloud.com/repository/maven/org/jacoco/$artifact.jar" -O "$name.jar"; \
      wget -q "https://repo.huaweicloud.com/repository/maven/org/jacoco/$artifact.jar.sha512" -O "$name.sha512"; \
      printf '%s  %s.jar\n' "$(cat "$name.sha512")" "$name" | sha512sum -c -; \
    done
COPY --from=application /app/app.jar /work/app.jar
WORKDIR /work
RUN jar xf app.jar BOOT-INF/classes

FROM application
USER root
COPY --from=tooling /tools/org.jacoco.agent-0.8.14-runtime.jar /opt/jacoco/agent.jar
COPY --from=tooling /tools/org.jacoco.cli-0.8.14-nodeps.jar /opt/jacoco/cli.jar
COPY --from=tooling /work/BOOT-INF/classes/com /opt/jacoco/classes/com
COPY src/main/java /opt/jacoco/source
USER 10001:10001
# Enable the agent in the Swarm service environment, not in the image default.
