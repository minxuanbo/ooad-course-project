+package cn.edu.xmu.projectmgt.r1;
+
+import cn.edu.xmu.projectmgt.infrastructure.persistence.entity.TermEntity;
+import cn.edu.xmu.projectmgt.infrastructure.persistence.repository.TermJpaRepository;
+import cn.edu.xmu.projectmgt.service.port.term.TermUseCase;
+import java.time.LocalDate;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+import cn.edu.xmu.projectmgt.shared.TestUnifiedIdentityClient;
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** R34分别提交后再切换学期，避免单一测试事务掩盖唯一索引更新顺序。 */
+@ActiveProfiles("test")
+@SpringBootTest(properties = "app.backend-strategy=ddd")
+class R34DddDeploymentTermTest {
+    @Autowired
+    private TermJpaRepository terms;
+    @Autowired
+    private TermUseCase service;
+
+    /** R34旧当前学期与目标均已提交时，切换必须先释放唯一标记。 */
+    @Test
+    @DisplayName("R34 DDD独立事务切换已存在当前学期")
+    void replacesCommittedCurrentTerm() {
+        MockHttpServletRequest request = new MockHttpServletRequest();
+        request.addHeader("Authorization", TestUnifiedIdentityClient.DEFAULT_TOKEN);
+        RequestContextHolder.setRequestAttributes(new ServletRequestAttributes(request));
+        TermEntity first = newTerm("R34-old", true);
+        TermEntity second = newTerm("R34-new", false);
+        terms.saveAndFlush(first);
+        terms.saveAndFlush(second);
+        try {
+            assertDoesNotThrow(() -> service.replaceCurrentTerm(second.getId()));
+            assertTrue(terms.findById(second.getId()).orElseThrow().getCurrent());
+        } finally {
+            terms.deleteById(second.getId());
+            terms.deleteById(first.getId());
+            RequestContextHolder.resetRequestAttributes();
+        }
+    }
+
+    /** 创建仅供隔离测试库使用的学期。 */
+    private TermEntity newTerm(String name, boolean current) {
+        TermEntity term = new TermEntity();
+        term.setName(name);
+        term.setStartDate(LocalDate.of(2028, 2, 1));
+        term.setEndDate(LocalDate.of(2028, 7, 1));
+        term.setCurrent(current);
+        return term;
+    }
+}
