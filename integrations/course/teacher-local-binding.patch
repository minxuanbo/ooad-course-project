+package cn.edu.xmu.projectmgt.r42;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import cn.edu.xmu.projectmgt.infrastructure.persistence.entity.TeacherEntity;
+import cn.edu.xmu.projectmgt.infrastructure.persistence.repository.TeacherJpaRepository;
+import cn.edu.xmu.projectmgt.infrastructure.security.BearerAuthenticationFilter;
+import cn.edu.xmu.projectmgt.service.ddd.domain.model.CurrentIdentity;
+import cn.edu.xmu.projectmgt.service.port.common.UnifiedIdentityGateway;
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.Optional;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.dao.DataAccessResourceFailureException;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import tools.jackson.databind.ObjectMapper;
+
+/** R42统一身份令牌的教师请求必须继续满足课程本地有效名单。 */
+class R42BoundTeacherFilterTest {
+  private UnifiedIdentityGateway identity;
+  private TeacherJpaRepository teachers;
+  private BearerAuthenticationFilter filter;
+
+  /** 只隔离身份端口与名单存储，判断实际HTTP放行/拒绝结果。 */
+  @BeforeEach
+  void prepare() {
+    identity = mock(UnifiedIdentityGateway.class);
+    teachers = mock(TeacherJpaRepository.class);
+    filter = new BearerAuthenticationFilter(identity, new ObjectMapper(), teachers);
+    when(identity.currentIdentity()).thenReturn(new CurrentIdentity("5", List.of("teacher"), List.of("CV", "TC")));
+  }
+
+  /** 直接从身份服务拿到有权限的教师令牌仍不能绕过本地名单。 */
+  @Test
+  @DisplayName("R42 未绑定本地教师的有效统一身份令牌返回403")
+  void R42_UnboundTeacherDenied() throws Exception {
+    when(teachers.findByUserId("5")).thenReturn(Optional.empty());
+    assertEquals(403, request());
+  }
+
+  /** 有效绑定只通过认证，后续权限仍由原业务服务执行。 */
+  @Test
+  @DisplayName("R42 有效本地教师绑定放行后续处理")
+  void R42_BoundTeacherAllowed() throws Exception {
+    when(teachers.findByUserId("5")).thenReturn(Optional.of(new TeacherEntity()));
+    assertEquals(204, request());
+  }
+
+  /** 软删除绑定不能作为继续访问的资格。 */
+  @Test
+  @DisplayName("R42 已删除的本地教师绑定返回403")
+  void R42_DeletedTeacherDenied() throws Exception {
+    TeacherEntity teacher = new TeacherEntity();
+    teacher.setDeletedAt(LocalDateTime.now());
+    when(teachers.findByUserId("5")).thenReturn(Optional.of(teacher));
+    assertEquals(403, request());
+  }
+
+  /** 不缓存绑定结论，同一原令牌在下一请求读取名单变更。 */
+  @Test
+  @DisplayName("R42 原令牌下一请求实时发现教师绑定撤回")
+  void R42_BindingIsReadOnEachRequest() throws Exception {
+    when(teachers.findByUserId("5")).thenReturn(Optional.of(new TeacherEntity()), Optional.empty());
+    assertEquals(204, request());
+    assertEquals(403, request());
+  }
+
+  /** 本地存储故障也必须拒绝，不降级为跳过名单校验。 */
+  @Test
+  @DisplayName("R42 教师名单存储故障返回503且不执行业务")
+  void R42_StorageFailureDenied() throws Exception {
+    when(teachers.findByUserId("5")).thenThrow(new DataAccessResourceFailureException("synthetic failure"));
+    assertEquals(503, request());
+  }
+
+  /** 学生认证保持老师原流程，本轮不扩展学生接入规则。 */
+  @Test
+  @DisplayName("R42 学生身份保持原过滤器处理行为")
+  void R42_StudentPathUnchanged() throws Exception {
+    when(identity.currentIdentity()).thenReturn(new CurrentIdentity("6", List.of("student"), List.of()));
+    assertEquals(204, request());
+  }
+
+  /** 下游以204标记实际被执行，拒绝时只能观察过滤器自己的HTTP状态。 */
+  private int request() throws Exception {
+    MockHttpServletRequest request = new MockHttpServletRequest("GET", "/admin/courses");
+    request.addHeader("Authorization", "Bearer r42-synthetic-token");
+    MockHttpServletResponse response = new MockHttpServletResponse();
+    filter.doFilter(request, response, (incoming, outgoing) -> ((jakarta.servlet.http.HttpServletResponse) outgoing).setStatus(204));
+    return response.getStatus();
+  }
+}
